# Copy to gpu-worker.env and fill in.

# Address of the Vividora API inside the Ubuntu VM (its LAN IP, port 8000)
API_URL=http://192.168.1.50:8000

# Must match WORKER_TOKEN in the server's .env
WORKER_TOKEN=change-this-to-a-long-random-string

# Whisper model for Hindi: large-v3 (best, ~3 GB VRAM in float16) · medium · small
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE=float16

# Optional: words/phrases that help spelling (channel name, recurring names)
# WHISPER_PROMPT=प्रशांत महतो, motivational, कहानी

# Missed-speech tuning (defaults are tuned for Hindi talking-head videos; same names on the server worker)
# WHISPER_VAD=1                    0 = no VAD at all
# WHISPER_VAD_THRESHOLD=0.3        lower = quiet speech is kept
# WHISPER_VAD_MIN_SILENCE_MS=1000
# WHISPER_VAD_PAD_MS=500
# WHISPER_NO_SPEECH=0.9            a 30 s window is skipped only above this
# WHISPER_BEAM=5  WHISPER_BEST_OF=5  WHISPER_COMPRESSION=2.8  WHISPER_LOGPROB=-1.0
# WHISPER_GAP_PASS=1               re-hear stretches with sound but no words
# WHISPER_GAP_MIN=1.2  WHISPER_GAP_MIN_VOICED=0.4  WHISPER_GAP_MAX=60  WHISPER_GAP_MIN_PROB=0.3
# WHISPER_HALLUCINATION_SILENCE=   (off; e.g. 2.0 turns faster-whisper's skipping back on)

# No NVIDIA GPU (e.g. AMD RX 580)? Only make AI voices here, on the CPU:
#   TRANSCRIBE=0  WHISPER_DEVICE=cpu  DUB=1  PARLER_DTYPE=float32
# TRANSCRIBE=0

# AI voice-over (dub jobs): 1 = this PC makes them (needs requirements-tts.txt), 0 = off
# DUB=1
# PARLER_DTYPE=float16

# WORKER_NAME=gpu@tower
# POLL_SECONDS=4
