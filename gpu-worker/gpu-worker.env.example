# Copy to gpu-worker.env and fill in.

# Address of the Vividora API inside the Ubuntu VM (its LAN IP, port 8000)
API_URL=http://192.168.1.50:8000

# Must match WORKER_TOKEN in the server's .env
WORKER_TOKEN=change-this-to-a-long-random-string

# Whisper model for Hindi: large-v3 (best, ~3 GB VRAM in float16) · medium · small
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE=float16

# Optional: words/phrases that help spelling (channel name, recurring names)
# WHISPER_PROMPT=प्रशांत महतो, motivational, कहानी

# WORKER_NAME=gpu@tower
# POLL_SECONDS=4
