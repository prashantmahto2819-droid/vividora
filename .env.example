# ---- Vividora server settings (copy to .env) ----

# Long random strings. Generate: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string
WORKER_TOKEN=change-me-to-another-long-random-string

# First admin account (created on first start; change the password after login)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=Prashant

# Where files live on the VM (see the setup guide: media on the 300 GB disk)
DATA_DIR=/srv/studio/data
MEDIA_DIR=/srv/studio/media
ARCHIVE_DIR=/srv/studio/archive

# Resources the render worker may use (leave room for other containers)
WORKER_CPUS=12
WORKER_MEM=16g

# Transcription on the VM's CPU: small (fast, rough) · medium (good) · large-v3 (best, slow)
WHISPER_MODEL=large-v3
WHISPER_THREADS=12

# Raw files move to the archive drive this many days after approval
ARCHIVE_AFTER_DAYS=30

# Optional
# ACCESS_TOKEN_HOURS=72
# CORS_ORIGINS=http://localhost:5173
# X264_PRESET=medium

# AI (optional, pay-per-use, tiny cost): Shorts titles/hooks, scripts, trend summaries.
# Without a key Vividora uses offline heuristics.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=

# Publishing (optional). PUBLIC_URL = your Cloudflare Tunnel hostname, e.g. https://studio.example.com
PUBLIC_URL=
# Google Cloud → OAuth client (Web) with redirect ${PUBLIC_URL}/api/connect/youtube/callback
YT_CLIENT_ID=
YT_CLIENT_SECRET=
# Meta developer app (Business) with redirect ${PUBLIC_URL}/api/connect/meta/callback
META_APP_ID=
META_APP_SECRET=
# 1 = pretend to publish (test the flow without touching real accounts)
PUBLISH_DRY_RUN=0

# Trend radar. Google Trends needs nothing. YouTube "most popular" needs an API key
# (Google Cloud → Credentials → API key, YouTube Data API v3 enabled; 1 unit per refresh).
YT_API_KEY=
TREND_REGION=IN
# channels to watch, comma-separated channel ids (UC…): public RSS, no key
WATCH_CHANNELS=

# WhatsApp notifications through your Vivid Relay gateway (or any HTTP webhook).
# Body template: {to} and {text} are filled in. Adjust to your gateway's API.
NOTIFY_URL=
NOTIFY_TOKEN=
NOTIFY_TO=
NOTIFY_TEMPLATE={"to": "{to}", "message": "{text}"}
# Replies ("ok 7F3A") come back to POST /api/hooks/inbound with header X-Hook-Secret
NOTIFY_INBOUND_SECRET=

# Archive (optional). Approved projects' raw files move here after ARCHIVE_AFTER_DAYS;
# finished renders are backed up too. Google Drive via rclone (see docs/google-drive.md):
ARCHIVE_RCLONE_REMOTE=
RCLONE_CONFIG_DIR=/home/prashant/.config/rclone

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → Create → Docker). Public hostname → http://api:8000
CLOUDFLARE_TUNNEL_TOKEN=
