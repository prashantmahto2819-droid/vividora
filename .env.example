# ---- Vividora server settings (copy to .env) ----

# Long random strings. Generate: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string
WORKER_TOKEN=change-me-to-another-long-random-string

# First admin account (created on first start; change the password after login)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=Prashant

# Where files live on the VM (see the setup guide: media on the 300 GB disk)
DATA_DIR=/srv/studio/data
MEDIA_DIR=/srv/studio/media
ARCHIVE_DIR=/srv/studio/archive

# Resources the render worker may use (leave room for other containers)
WORKER_CPUS=12
WORKER_MEM=16g

# Raw files move to the archive drive this many days after approval
ARCHIVE_AFTER_DAYS=30

# Optional
# ACCESS_TOKEN_HOURS=72
# CORS_ORIGINS=http://localhost:5173
# X264_PRESET=medium
